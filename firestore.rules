rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/workspaces/{workspaceId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['id', 'name', 'color', 'updatedAt'])
        && request.resource.data.id == workspaceId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.color is string
        && request.resource.data.updatedAt is int;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly([
          'id', 'workspaceId', 'title', 'description', 'status', 'dueAt', 'updatedAt'
        ])
        && request.resource.data.id == taskId
        && request.resource.data.workspaceId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 240
        && request.resource.data.description is string
        && request.resource.data.status in ['todo', 'doing', 'done']
        && (request.resource.data.dueAt == null || request.resource.data.dueAt is int)
        && request.resource.data.updatedAt is int;
    }
  }
}
